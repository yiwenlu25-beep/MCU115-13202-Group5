<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Main Meal"
        android:textSize="18sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgMainMeal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <RadioButton
            android:id="@+id/rbBurger"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Burger" />

        <RadioButton
            android:id="@+id/rbFriedChicken"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fried Chicken" />

        <RadioButton
            android:id="@+id/rbNuggets"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chicken Nuggets" />
    </RadioGroup>

    <Button
        android:id="@+id/btnMainDone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Done" />
</LinearLayout>